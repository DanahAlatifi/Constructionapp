{
  "expo": {
    "name": "Contracting Lite",
    "slug": "contracting-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4947ae"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plustech.contractinglite",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لمسح باركود الدخول وإرفاق صور بالتقارير.",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق المعرض لإرفاق صور بالتقارير اليومية.",
        "NSLocationWhenInUseUsageDescription": "يستخدم التطبيق موقعك لحساب المسافة إلى مواقع المشاريع على الخريطة.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#4947ae"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "f7089925-50bc-4795-932d-7555bffd6ae7"
      }
    },
    "plugins": [
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "يسمح للتطبيق باستخدام الكاميرا لمسح الباركود."
        }
      ],
      "expo-notifications"
    ]
  }
}
